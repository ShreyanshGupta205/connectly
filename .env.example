# Dedicated Least-Privilege OpenGraph Edge Reader
# IMPORTANT: api/og.mjs reads ONLY OG_DATABASE_URL (pooled port 6543, pgbouncer=true, with restricted og_reader credentials).
# If unset or failing, api/og.mjs returns the generic no-store fallback. It NEVER falls back to DATABASE_URL.
OG_DATABASE_URL="postgresql://og_reader:[OG-READER-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Primary Application Database Connection Strings
DATABASE_URL="postgresql://postgres.rbmcfsuupcojncyqmywm:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_POOLED="postgresql://postgres.rbmcfsuupcojncyqmywm:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.rbmcfsuupcojncyqmywm:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Project Details
VITE_SUPABASE_URL="https://rbmcfsuupcojncyqmywm.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Canonical Site URL (used for Edge OG bot cards and modern path URL builders)
# In production: https://connectly.bio (or your custom domain)
# In preview: https://your-preview-deployment.vercel.app (or left blank for automatic header fallback)
SITE_URL="https://connectly-hazel.vercel.app"
VITE_SITE_URL="https://connectly-hazel.vercel.app"

# Privacy-Friendly Product Analytics (PostHog Free Tier: 1,000,000 events/month free)
VITE_POSTHOG_API_KEY="your-posthog-project-api-key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"
