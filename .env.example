# =====================================================================
# Connectly Environment Configuration Template
# =====================================================================

# 1. Dedicated Least-Privilege OpenGraph Edge Reader (api/og.mjs)
# IMPORTANT: api/og.mjs reads ONLY OG_DATABASE_URL with restricted og_reader credentials.
# If unset or failing, api/og.mjs returns the generic no-store fallback. It NEVER falls back to DATABASE_URL.
#
# SUPABASE POOLER SETUP INSTRUCTIONS:
# - Username Format: When connecting via the Supabase pooler (Supavisor), custom roles MUST use:
#     og_reader.<project-ref>
# - Host & Port: Copy the pooler host and port directly from your Supabase Dashboard:
#     Dashboard -> Project Settings -> Database -> Connection string / Connect panel
#     Select 'Transaction' mode (typically port 6543) or 'Session' mode (port 5432).
# - Query parameters: Extraneous query parameters (like ?pgbouncer=true) are not needed with Supavisor.
OG_DATABASE_URL="postgresql://og_reader.<project-ref>:[OG-READER-PASSWORD]@<pooler-host>:6543/postgres"

# 2. Primary Application Database Connection Strings
# Copy host and pooler credentials from Supabase Dashboard -> Settings -> Database
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:6543/postgres"
DATABASE_URL_POOLED="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<direct-host>:5432/postgres"

# 3. Supabase Project Details
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# 4. Canonical Site URL (used for Edge OG bot cards and modern path URL builders)
# In production: https://connectly.bio (or your custom domain)
# In preview: https://your-preview-deployment.vercel.app (or left blank for automatic header fallback)
SITE_URL="https://connectly.bio"
VITE_SITE_URL="https://connectly.bio"

# 5. Server Admin API Key (used to authorize admin endpoints like /api/admin/verify)
ADMIN_SECRET_KEY="your-secure-admin-secret-key-here"

# 6. Privacy-Friendly Product Analytics (PostHog Free Tier: 1,000,000 events/month free)
VITE_POSTHOG_API_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
